[
  {
    "name": "Test data cleanup failures",
    "matchedStatuses": [
      "failed",
      "broken"
    ],
    "messageRegex": "(?s).*Failed to execute [0-9]+ cleanup action\\(s\\).*$"
  },
  {
    "name": "External Petstore 5xx failures",
    "matchedStatuses": [
      "failed",
      "broken"
    ],
    "messageRegex": "(?s).*Expected status code <[1-5][0-9]{2}> but was <5[0-9]{2}>.*$"
  },
  {
    "name": "Network and timeout failures",
    "matchedStatuses": [
      "failed",
      "broken"
    ],
    "traceRegex": "(?s).*(ConnectException|Connection refused|SocketTimeoutException|HttpTimeoutException|UnknownHostException|Read timed out).*$"
  },
  {
    "name": "Serialization and deserialization failures",
    "matchedStatuses": [
      "broken"
    ],
    "traceRegex": "(?s).*(JsonProcessingException|MismatchedInputException|UnrecognizedPropertyException|InvalidFormatException).*$"
  }
]